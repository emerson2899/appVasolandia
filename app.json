{
  "expo": {
    "name": "Vasolandia",
    "slug": "vasolandiaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emersonfel2899.vasolandiaapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.emersonfel2899.vasolandiaapp",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b0f94ec3-78ac-427c-8fa6-accf5c8214d1"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
    
    
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true,
          "androidx": true,
            "extraMavenRepos": [
              "https://jcenter.bintray.com/"],
            "agpVersion": "8.2.1"
          }
        }
      ]
    ]
  }
}